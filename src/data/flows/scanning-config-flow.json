      "label": "Gateway (Apollo)"
    },
    {
      "id": "lec-scanningconfig-api",
      "type": "service",
      "position": [
        400,
        50
      ],
      "label": "ScanningConfig API (vnext)"
    },
    {
      "id": "mongodb-scanningconfig",
      "type": "database",
      "position": [
        400,
        230
      ],
      "label": "MongoDB"
    },
    {
      "id": "public.event.scanning-config",
      "type": "topic",
      "position": [
        1009,
        -206
      ],
      "label": "public.event.scanning-config"
    },
    {
      "id": "lec-analytics-assets-consumer-v2-management-entities",
      "type": "service",
      "position": [
        1300,
        50
      ],
      "label": "Analytics Consumer (mgmt)"
    },
    {
      "id": "public.edge.install-status.event",
      "type": "topic",
      "position": [
        400,
        450
      ],
      "label": "public.edge.install-status.event"
    },
    {
      "id": "public.event.discovery",
      "type": "topic",
      "position": [
        400,
        590
      ],
      "label": "public.event.discovery"
    },
    {
      "id": "public.event.multitenant",
      "type": "topic",
      "position": [
        400,
        730
      ],
      "label": "public.event.multitenant"
    },
    {
      "id": "lec-scanningconfig-consumer",
      "type": "service",
      "position": [
        900,
        590
      ],
      "label": "ScanningConfig Consumer (vnext)",
      "annotations": [
        {
          "text": "Reacts to 3 event sources → produces to edge.commands + scanning-config + webhooks.sources",
          "severity": "info"
        }
      ]
    },
    {
      "id": "public.edge.commands",
      "type": "topic",
      "position": [
        1400,
        400
      ],
      "label": "public.edge.commands",
      "annotations": [
        {
          "text": "Both API and Consumer publish here — this is how config reaches on-prem",
          "severity": "warning"
        }
      ]
    },
    {
      "id": "public-broker",
      "type": "service",
      "position": [
        1850,
        400
      ],
      "label": "Public Broker"
    },
    {
      "id": "mongodb-commands",
      "type": "database",
      "position": [
        2215,
        562
      ],
      "label": "MongoDB (Commands)"
    },
    {
      "id": "lec-edge-command-api",
      "type": "service",
      "position": [
        2585,
        305
      ],
      "label": "Edge Command API"
    },
    {
      "id": "discovery-config-api",
      "type": "service",
      "position": [
        2563,
        695
      ],
      "label": "discovery-config-api"
    },
    {
      "id": "scanner",
