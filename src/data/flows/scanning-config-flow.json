{
  "id": "scanning-config-flow",
  "name": "Scanning Configuration → Vnext/Onprem",
  "description": "Config changes in cloud reach the Vnext scanner: API + Consumer both publish to edge.commands → public-broker → EdgeCommand → scanner",
