{
  "id": "credentials-flow",
  "name": "Credentials Lifecycle (Cloud ↔ HUB)",
  "description": "Bidirectional credentials sync rooted in scanning-config. Push arc: Portal creates/updates credential → ScanningConfig API persists encrypted in Mongo + publishes Avro to public.edge.commands → public-broker → MongoDB Commands → EdgeCommand API → HUB pulls via gRPC and stores in local SQLite vault. Ack arc: HUB calls cloud gRPC CredentialVaultReferenceService → published to public.event.discovery (proto v2) → ScanningConfig Consumer updates Mongo + publishes to Redis pub/sub channel `discovery-updated-credential` → ScanningConfig Subscriptions (GraphQL ws :4040) → Gateway stitching → Portal receives UpdatedCredentialAck.",
  "nodes": [
    {
      "id": "portal",
      "type": "scanner",
      "label": "Portal (User)",
      "position": [
        0,
        80
      ]
    },
    {
      "id": "lec-gateway-api",
      "type": "service",
      "label": "Gateway (Apollo)",
      "position": [
        400,
        80
      ],
      "annotations": [
        {
          "text": "Apollo Federation. Stitches GraphQL Subscriptions to lec-scanningconfig-subscriptions:4040.",
          "severity": "info"
        }
      ]
    },
    {
      "id": "lec-scanningconfig-api",
      "type": "service",
      "label": "ScanningConfig API (vnext)",
      "position": [
        800,
        80
      ],
      "annotations": [
        {
          "text": "Go GraphQL/gRPC API. Triggers NotifyCredentialsChangeEvent on credential CRUD.",
          "severity": "info"
        }
      ]
    },
    {
      "id": "mongodb-scanningconfig",
      "type": "database",
      "label": "MongoDB (ScanningConfig)",
      "position": [
        800,
        260
      ]
    },
    {
      "id": "public.edge.commands",
      "type": "topic",
      "position": [
        1200,
        80
      ],
      "annotations": [
        {
          "text": "Carries Avro CreateOrUpdateCredential, ShareCredential, DeleteCredential schemas (alongside scan commands).",
          "severity": "warning"
        }
      ]
    },
    {
      "id": "public-broker",
      "type": "service",
      "label": "Public Broker",
      "position": [
        1600,
        80
      ]
    },
    {
      "id": "mongodb-commands",
      "type": "database",
      "label": "MongoDB (Commands)",
      "position": [
        1600,
        260
      ]
    },
    {
      "id": "lec-edge-command-api",
      "type": "service",
      "label": "Edge Command API",
      "position": [
        2000,
        80
      ]
    },
    {
      "id": "hub-onprem",
      "type": "scanner",
      "label": "HUB (Lansweeper.IT)",
      "position": [
        2400,
        80
      ],
      "annotations": [
        {
          "text": "On-prem agent. Stores credential in local SQLite vault, then upserts CredentialVaultReference back to cloud via gRPC.",
          "severity": "info"
        }
      ]
    },
    {
      "id": "hub-vault",
      "type": "database",
      "label": "SQLite (Hub Vault)",
      "position": [
        2400,
        260
      ]
    },
    {
      "id": "discovery-config-api",
      "type": "service",
      "label": "Discovery Config API",
      "position": [
        2000,
        500
      ],
      "annotations": [
        {
          "text": "gRPC server for HUB. Receives CredentialVaultReferenceService.SendUpsertCredentialVaultReference (streaming) and produces to public.event.discovery.",
          "severity": "info"
        }
      ]
    },
    {
      "id": "public.event.discovery",
      "type": "topic",
      "position": [
        1600,
        500
      ],
      "annotations": [
        {
          "text": "Carries proto lansweeper.discovery.credential.v2.DiscoveryCredentialVaultReference (UPSERT/DELETE operations + vault metadata).",
          "severity": "warning"
        }
      ]
    },
    {
      "id": "lec-scanningconfig-consumer",
      "type": "service",
      "label": "ScanningConfig Consumer (vnext)",
      "position": [
        1200,
        500
      ],
      "annotations": [
        {
          "text": "Updates Mongo with vault reference. NOTIFY_UPDATED_CREDENTIAL_ACK=true → publishes to Redis pub/sub channel.",
          "severity": "info"
        }
      ]
    },
    {
      "id": "redis-scanningconfig",
      "type": "database",
      "label": "Redis pub/sub\n(discovery-updated-credential)",
      "position": [
        800,
        500
      ],
      "annotations": [
        {
          "text": "Channel: discovery-updated-credential. Also discovery-deleted-source for source removals.",
          "severity": "info"
        }
      ]
    },
    {
      "id": "lec-scanningconfig-subscriptions",
      "type": "service",
      "label": "ScanningConfig Subscriptions (vnext)",
      "position": [
        400,
        500
      ],
      "annotations": [
        {
          "text": "Go GraphQL Subscriptions on :4040. Subscribes to Redis channel and emits UpdatedCredentialAck via WebSocket. Stitched by Gateway as subscriptionStitchingServices.scanningConfigSubscriptionUrl.",
          "severity": "info"
        }
      ]
    }
  ],
  "edges": [
    {
      "source": 0,
      "target": 1,
      "type": "https",
      "label": "GraphQL mutation"
    },
    {
      "source": 1,
      "target": 2,
      "type": "https",
      "label": "Apollo Federation"
    },
    {
      "source": 2,
      "target": 3,
      "type": "db",
      "label": "encrypted persist"
    },
    {
      "source": 2,
      "target": 4,
      "type": "kafka",
      "label": "Avro NotifyCredential"
    },
    {
      "source": 4,
      "target": 5,
      "type": "kafka"
    },
    {
      "source": 5,
      "target": 6,
      "type": "db",
      "label": "store command"
    },
    {
      "source": 7,
      "target": 6,
      "type": "db",
      "label": "poll + delete on ack"
    },
    {
      "source": 7,
      "target": 8,
      "type": "grpc",
      "label": "send credential"
    },
    {
      "source": 8,
      "target": 7,
      "type": "grpc",
      "label": "ReceiptHandle ack"
    },
    {
      "source": 8,
      "target": 9,
      "type": "internal",
      "label": "store local"
    },
    {
      "source": 8,
      "target": 10,
      "type": "grpc",
      "label": "CredentialVaultReferenceService\n(streaming, M2M auth)"
    },
    {
      "source": 10,
      "target": 11,
      "type": "kafka",
      "label": "proto v2"
    },
    {
      "source": 11,
      "target": 12,
      "type": "kafka"
    },
    {
      "source": 12,
      "target": 3,
      "type": "db",
      "label": "update vaultStatus"
    },
    {
      "source": 12,
      "target": 13,
      "type": "db",
      "label": "PUBLISH"
    },
    {
      "source": 13,
      "target": 14,
      "type": "db",
      "label": "SUBSCRIBE"
    },
    {
      "source": 14,
      "target": 1,
      "type": "https",
      "label": "WebSocket subscription"
    },
    {
      "source": 1,
      "target": 0,
      "type": "https",
      "label": "UpdatedCredentialAck"
    }
  ]
}
